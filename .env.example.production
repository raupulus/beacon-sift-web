# Configuración de la aplicación (Producción)
APP_NAME="beacon-sift"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://feed.raupulus.dev
APP_TIMEZONE=Europe/Madrid

# Localización
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

# Base de datos — PostgreSQL global
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=beacon_sift
DB_USERNAME=fryntiz
DB_PASSWORD=

# Cache y Sesiones
CACHE_STORE=redis
CACHE_PREFIX=beacon_sift_
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Colas y Broadcasting (WebSockets públicos con Laravel Reverb)
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=beacon-sift
REVERB_APP_KEY=beacon-sift-public-key
REVERB_APP_SECRET=
REVERB_HOST=feed.raupulus.dev
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8082

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Configuración de beacon-sift
# BEACON_SOURCES_PATH= (si se omite, usa storage_path('app/sources.json'))
BEACON_FETCH_LOGS_RETENTION_DAYS=30
BEACON_ITEMS_RETENTION_DAYS=0
BEACON_SNIPPET_MAX_LENGTH=160
BEACON_HTTP_TIMEOUT=15
BEACON_BROADCAST_CHANNEL=beacon.news
BEACON_CONTACT_EMAIL=public@raupulus.dev

# Logs
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
