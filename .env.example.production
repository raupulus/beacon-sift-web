# Archivo de ejemplo de variables de entorno para PRODUCCIÓN (beacon-sift-web)
# Copia este archivo como .env en producción y ajusta credenciales sin versionarlo

APP_NAME="beacon-sift"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://feed.raupulus.dev
APP_TIMEZONE=Europe/Madrid
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

# Base de datos PostgreSQL global (obligatoria en producción)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=beacon_sift
DB_USERNAME=beacon_sift
DB_PASSWORD=

# Caché, sesiones y colas
CACHE_STORE=file
CACHE_PREFIX=beacon_sift_
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=database

# Broadcasting (WebSockets públicos con Laravel Reverb)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=beacon-sift
REVERB_APP_KEY=beacon-sift-public-key
REVERB_APP_SECRET=change-me-in-production
REVERB_HOST=feed.raupulus.dev
REVERB_PORT=443
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_APP_KEY:+feed.raupulus.dev}"
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# Configuración específica de beacon-sift
BEACON_SOURCES_PATH=
BEACON_FETCH_LOGS_RETENTION_DAYS=30
BEACON_ITEMS_RETENTION_DAYS=0
BEACON_SNIPPET_MAX_LENGTH=160
BEACON_HTTP_TIMEOUT=15
BEACON_BROADCAST_CHANNEL=beacon.news
BEACON_CONTACT_EMAIL=public@raupulus.dev

# Logs
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
