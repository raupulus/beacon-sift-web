# Configuración de la aplicación
APP_NAME="beacon-sift"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Madrid

# Localización
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

# Base de datos — PostgreSQL global
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=beacon_sift
DB_USERNAME=postgres
DB_PASSWORD=

# Cache y Sesiones
CACHE_STORE=file
CACHE_PREFIX=beacon_sift_
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Colas y Broadcasting (WebSockets públicos con Laravel Reverb)
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=beacon-sift
REVERB_APP_KEY=beacon-sift-public-key
REVERB_APP_SECRET=change-me-in-production
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Configuración de beacon-sift
BEACON_SOURCES_PATH=
BEACON_FETCH_LOGS_RETENTION_DAYS=30
BEACON_ITEMS_RETENTION_DAYS=0
BEACON_SNIPPET_MAX_LENGTH=160
BEACON_HTTP_TIMEOUT=15
BEACON_BROADCAST_CHANNEL=beacon.news
BEACON_CONTACT_EMAIL=public@raupulus.dev

# Logs
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
